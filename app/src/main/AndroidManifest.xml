<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 10's storage advisor needs to check whether an arbitrary package name (found from
         an Android/media/PACKAGE folder at scan time, not knowable ahead of time) is still
         installed. A static queries entry can't cover that, since it only works for
         predetermined targets. Google Play's policy explicitly lists file manager apps as a core
         use case for this permission; the Play Console submission still needs its own
         declaration/justification for that policy, which is outside what this manifest change
         can do on its own. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Phase 17's daily insights summary notification. On API 33+ this is a dangerous
         permission requiring a runtime request: Settings' "Notify me" toggle (still open,
         see docs/PLAN.md Phase 17) is where that request/rationale will live; until then
         InsightsNotifier just checks it and silently skips posting if it isn't granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 15's update checker: this app's first and only network access, used exclusively
         for a user-initiated "Check for updates" tap (never automatic/background). Scoped to one
         GET against the public GitHub Releases API; nothing else in the app makes a network call. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed to launch the system package installer on the APK Settings' "Check for updates"
         downloads: Android treats installing from an app-provided file as installing from an
         "unknown source" regardless of where that file came from. `ApkSignatureVerifier` refuses
         to offer the install prompt at all unless the downloaded APK is signed with this app's own
         certificate, so this permission can never be used to install something this app didn't
         itself fetch from its own GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".EfmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExtendedFileManager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExtendedFileManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 6 needs Hilt-injected Workers (DuplicateScanWorker), so WorkManager's own
             default initializer is disabled here in favor of EfmApplication's
             Configuration.Provider, which supplies a HiltWorkerFactory instead. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Phase 15's update checker needs a content:// Uri for the APK it downloads into its
             own app-private external files dir: the system installer can't be handed a file://
             Uri across app boundaries on modern Android. Scoped to just that one directory, not
             the whole app-private tree. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
