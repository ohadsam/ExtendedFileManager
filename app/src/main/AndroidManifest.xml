<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phase 10's storage advisor needs to check whether an arbitrary package name (found from
         an Android/media/PACKAGE folder at scan time, not knowable ahead of time) is still
         installed. A static queries entry can't cover that, since it only works for
         predetermined targets. Google Play's policy explicitly lists file manager apps as a core
         use case for this permission; the Play Console submission still needs its own
         declaration/justification for that policy, which is outside what this manifest change
         can do on its own. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Phase 17's daily insights summary notification. On API 33+ this is a dangerous
         permission requiring a runtime request -- Settings' "Notify me" toggle (still open,
         see docs/PLAN.md Phase 17) is where that request/rationale will live; until then
         InsightsNotifier just checks it and silently skips posting if it isn't granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EfmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ExtendedFileManager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ExtendedFileManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 6 needs Hilt-injected Workers (DuplicateScanWorker), so WorkManager's own
             default initializer is disabled here in favor of EfmApplication's
             Configuration.Provider, which supplies a HiltWorkerFactory instead. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
